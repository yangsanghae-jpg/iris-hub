{% extends "_base.html.j2" %}
{% block header %}
<div class="header"><h1>{{ title }}</h1><span class="pageno">{{ pageno }}/{{ total_pages }}</span></div>
{% endblock %}
{% block style %}
.phases { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 16px; }
.phase { border-radius: 10px; overflow: hidden; border: 1px solid var(--line); min-height: 320px; display: flex; flex-direction: column; }
.phase-h { min-height: 56px; padding: 10px 12px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 16px; text-align: center; }
.phase-h.blue-light { background: var(--blue-light); }
.phase-h.blue { background: var(--accent); }
.phase-h.orange { background: var(--orange); }
.phase-h.green { background: var(--green); }
.phase-h.red { background: var(--red, #e74c3c); }
.phase-h.purple { background: var(--purple, #8e44ad); }
.phase-body { padding: 16px; flex: 1; background: var(--bg-card); }
.phase-title { font-weight: 800; font-size: 16px; margin-bottom: 4px; line-height: 1.3; }
.phase-period { color: var(--fg-muted); font-size: 13px; margin-bottom: 12px; }
.task-item { font-size: 14px; margin-bottom: 8px; padding-left: 8px; border-left: 3px solid var(--accent); line-height: 1.4; }
.note { margin-top: 20px; background: #fef3c7; border-left: 4px solid var(--orange); padding: 14px 18px; font-size: 17px; color: #92400e; }
{% endblock %}
{% block body %}
<div class="subtitle">{{ subtitle }}</div>
<div class="phases">
  {% for phase in phases %}
  <div class="phase">
    <div class="phase-h {{ phase.color }}">{{ phase.label }}</div>
    <div class="phase-body">
      <div class="phase-title">{{ phase.title }}</div>
      <div class="phase-period">{{ phase.period }}</div>
      {% for task in phase.tasks %}<div class="task-item">{{ task }}</div>{% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{% if footer_note %}<div class="note">{{ footer_note }}</div>{% endif %}
{% endblock %}
