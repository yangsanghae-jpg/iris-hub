{% extends "_base.html.j2" %}
{% block header %}
<div class="header"><h1>{{ title }}</h1><span class="pageno">{{ pageno }}/{{ total_pages }}</span></div>
{% endblock %}
{% block style %}
.intro, .outro { background: var(--bg-card); padding: 20px 24px; border-left: 4px solid var(--accent); margin-bottom: 24px; border-radius: 0 8px 8px 0; }
.intro label, .outro label { font-weight: 800; color: var(--accent); display: block; margin-bottom: 10px; }
.section-title { font-weight: 800; font-size: 20px; margin-bottom: 16px; color: var(--accent); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px; }
.card { border-radius: 10px; overflow: hidden; border: 1px solid var(--line); }
.card-h { min-height: 70px; padding: 12px 16px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 18px; text-align: center; }
.card-h.blue { background: var(--accent); }
.card-h.orange { background: var(--orange); }
.card-h.green { background: var(--green); }
.card-h.red { background: var(--red, #e74c3c); }
.card-h.purple { background: var(--purple, #8e44ad); }
.card-b { padding: 16px; background: white; font-size: 15px; color: var(--fg-muted); min-height: 90px; line-height: 1.5; }
{% endblock %}
{% block body %}
<div class="subtitle">{{ subtitle }}</div>
{% if intro %}
<div class="intro"><label>{{ intro.label }}</label>{% for line in intro.lines %}<div>{{ line }}</div>{% endfor %}</div>
{% endif %}
<div class="section-title">{{ section_title }}</div>
<div class="cards">
  {% for c in cards %}
  <div class="card">
    <div class="card-h {{ c.color }}">{{ c.title }}</div>
    <div class="card-b">{{ c.subtitle }}</div>
  </div>
  {% endfor %}
</div>
{% if outro %}
<div class="outro"><label>{{ outro.label }}</label>{% for b in outro.bullets %}<div>{{ b }}</div>{% endfor %}</div>
{% endif %}
{% endblock %}
