{% extends "_base.html.j2" %}
{% block header %}
<div class="header"><h1>{{ title }}</h1><span class="pageno">{{ pageno }}/{{ total_pages }}</span></div>
{% endblock %}
{% block style %}
.metrics { display: flex; gap: 24px; margin-top: 20px; }
.metric { flex: 1; height: 240px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; }
.metric.blue { background: var(--accent); }
.metric.orange { background: var(--orange); }
.metric.red { background: var(--red); }
.metric.green { background: var(--green); }
.metric-val { font-size: 80px; font-weight: 800; line-height: 1; }
.metric-lbl { font-size: 24px; margin-top: 12px; opacity: 0.95; text-align: center; padding: 0 16px; }
{% endblock %}
{% block body %}
<div class="subtitle">{{ subtitle }}</div>
<div class="metrics">
  {% for m in metrics %}
  <div class="metric {{ m.color }}">
    <div class="metric-val">{{ m.value }}</div>
    <div class="metric-lbl">{{ m.label }}</div>
  </div>
  {% endfor %}
</div>
{% endblock %}
